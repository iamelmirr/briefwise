{
  "name": "kimi-lead",
  "displayName": "Kimi Lead",
  "description": "Kimi kao tech lead, Claude Code kao inženjer. Pričaš s Kimijem, Claudea gledaš uživo.",
  "version": "0.2.0",
  "publisher": "iamelmirr",
  "private": true,
  "license": "UNLICENSED",
  "engines": { "vscode": "^1.95.0" },
  "categories": ["Other"],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      { "command": "kimiLead.open", "title": "Otvori Kimija", "category": "Kimi Lead", "icon": "$(comment-discussion)" },
      { "command": "kimiLead.setApiKey", "title": "Postavi OpenRouter ključ", "category": "Kimi Lead" },
      { "command": "kimiLead.clearApiKey", "title": "Obriši OpenRouter ključ", "category": "Kimi Lead" },
      { "command": "kimiLead.stop", "title": "Zaustavi zadatak", "category": "Kimi Lead" },
      { "command": "kimiLead.newConversation", "title": "Nova konverzacija", "category": "Kimi Lead" }
    ],
    "keybindings": [
      { "command": "kimiLead.open", "key": "ctrl+alt+k", "mac": "cmd+alt+k" }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc -p .",
    "package": "node build.mjs && vsce package --no-dependencies --allow-missing-repository --skip-license -o kimi-lead.vsix"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  }
}
