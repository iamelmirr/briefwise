{
  "name": "briefwise",
  "displayName": "Briefwise",
  "description": "Talk to a lead model (any OpenRouter model). It turns your words into precise briefs for the real Claude Code, and you watch Claude work live.",
  "version": "0.4.0",
  "publisher": "iamelmirr",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "briefwise",
    "claude",
    "claude code",
    "openrouter",
    "lead",
    "ai"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "briefwise.open",
        "title": "Open",
        "category": "Briefwise",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "briefwise.setApiKey",
        "title": "Set OpenRouter key",
        "category": "Briefwise"
      },
      {
        "command": "briefwise.clearApiKey",
        "title": "Clear OpenRouter key",
        "category": "Briefwise"
      },
      {
        "command": "briefwise.stop",
        "title": "Stop task",
        "category": "Briefwise"
      },
      {
        "command": "briefwise.newConversation",
        "title": "New conversation",
        "category": "Briefwise"
      }
    ],
    "keybindings": [
      {
        "command": "briefwise.open",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc -p .",
    "package": "node build.mjs && vsce package --no-dependencies -o briefwise.vsix",
    "test": "node build.mjs && node dev/run-host-test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iamelmirr/briefwise.git"
  },
  "homepage": "https://github.com/iamelmirr/briefwise#readme",
  "bugs": {
    "url": "https://github.com/iamelmirr/briefwise/issues"
  }
}
