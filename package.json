{
  "name": "briefwise",
  "version": "0.4.0",
  "description": "Talk to a lead model (any OpenRouter model). It turns your words into precise briefs for the real Claude Code, and you watch Claude work live.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/iamelmirr/briefwise.git"
  },
  "homepage": "https://github.com/iamelmirr/briefwise#readme",
  "keywords": [
    "claude-code",
    "openrouter",
    "kimi",
    "briefwise",
    "ai-agents",
    "tech-lead",
    "vscode",
    "cli"
  ],
  "type": "module",
  "bin": {
    "briefwise": "bin/briefwise.mjs"
  },
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "start": "node bin/briefwise.mjs",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p .",
    "test": "node --experimental-strip-types --no-warnings --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "templates",
    "LICENSE",
    "README.md"
  ]
}
